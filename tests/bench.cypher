CREATE (pi:PowerRail {id: 'RAIL_PI'}),
       (supply:PowerRail {id: 'RAIL_5V'}),
       (a:Regulator {id: 'REG_A'}),
       (b:Regulator {id: 'REG_B'}),
       (bus1:Bus {id: 'I2C-1'}),
       (bus3:Bus {id: 'I2C-3'}),
       (uart:Bus {id: 'UART0'}),
       (imu:Device {id: 'imu'}),
       (mag:Device {id: 'mag'}),
       (epsmon:Device {id: 'epsmon'}),
       (thermal:Device {id: 'thermal'}),
       (sun1:Device {id: 'sun1'}),
       (sun2:Device {id: 'sun2'}),
       (payload:Device {id: 'payload'}),
       (radio:Device {id: 'radio'})
CREATE (a)-[:FED_BY]->(pi),
       (b)-[:FED_BY]->(supply),
       (imu)-[:POWERED_BY]->(b),
       (mag)-[:POWERED_BY]->(b),
       (epsmon)-[:POWERED_BY]->(a),
       (thermal)-[:POWERED_BY]->(a),
       (sun1)-[:POWERED_BY]->(b),
       (sun2)-[:POWERED_BY]->(a),
       (payload)-[:POWERED_BY]->(a),
       (radio)-[:POWERED_BY]->(supply),
       (imu)-[:ON_BUS]->(bus1),
       (mag)-[:ON_BUS]->(bus1),
       (epsmon)-[:ON_BUS]->(bus1),
       (thermal)-[:ON_BUS]->(bus1),
       (sun1)-[:ON_BUS]->(bus3),
       (sun2)-[:ON_BUS]->(bus3),
       (payload)-[:ON_BUS]->(bus3),
       (radio)-[:ON_BUS]->(uart)
CREATE (:TelemetryChannel {id: 'imu.gyro'})-[:READS]->(imu),
       (:TelemetryChannel {id: 'imu.accel'})-[:READS]->(imu),
       (:TelemetryChannel {id: 'mag.field'})-[:READS]->(mag),
       (voltage:TelemetryChannel {id: 'eps.regb.voltage'})-[:READS]->(epsmon),
       (:TelemetryChannel {id: 'thermal.temp'})-[:READS]->(thermal),
       (:TelemetryChannel {id: 'sun1.lux'})-[:READS]->(sun1),
       (:TelemetryChannel {id: 'sun2.lux'})-[:READS]->(sun2),
       (:TelemetryChannel {id: 'payload.temp'})-[:READS]->(payload),
       (:TelemetryChannel {id: 'radio.heartbeat'})-[:READS]->(radio)
CREATE (voltage)-[:MONITORS]->(b)
